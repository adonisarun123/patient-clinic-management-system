# PostgreSQL connection (Neon or any Postgres 14+). The role must NOT have BYPASSRLS or be a superuser,
# otherwise row-level tenant isolation is not enforced. On Neon do NOT use neondb_owner or any role created in the
# Neon console/CLI/API — those inherit BYPASSRLS. Create the app role with SQL (see docs/DEPLOYMENT.md step 1).
DATABASE_URL=postgres://clinic_app:password@localhost:5432/clinic_core
DB_POOL_MAX=10
# Direct (non-pooled) URL for migrations, when DATABASE_URL points at a connection pooler (Neon -pooler host).
# DATABASE_URL_UNPOOLED=

# Vercel: Bearer secret Vercel Cron sends to /api/cron/outbox. Blob: private store read-write token (enables object storage).
# CRON_SECRET=
# BLOB_READ_WRITE_TOKEN=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts each clinic's Razorpay/MSG91 credentials and peppers OTPs.
# Required in production. Changing it makes saved provider credentials unreadable (re-enter them).
APP_ENCRYPTION_KEY=

# Staging/demo servers only — NEVER set these on production:
# ALLOW_DEV_SMS=1            # OTPs written to the server log instead of sent by SMS
# ALLOW_SANDBOX_PAYMENTS=1   # simulated online payments when a clinic has no Razorpay keys
