{
  "name": "clinic-core",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant clinic patient management add-on (OPD core) for Monk Mantra client sites",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-platform-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "sync": "bash scripts/git-sync.sh"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "overrides": {
    "zod": "$zod"
  }
}
